PORT=3000
DATABASE_PATH=./data/bitlibera.sqlite

# Required to access the application. Use unique values and keep .env private.
APP_USERNAME=
APP_PASSWORD=
APP_SESSION_SECRET=

# Required only for real Blink transactions. Keep these values server-side.
BLINK_WALLET_ID=
BLINK_API_KEY=

# Optional BitLibera Gateway integration
BITLIBERA_API_KEY=

# Optional Blink username for legacy tools
BLINK_USERNAME=

# Optional Afripay integration
AFRIPAY_API_URL=
AFRIPAY_APP_ID=
AFRIPAY_APP_SECRET=
AFRIPAY_CURRENCY=
AFRIPAY_ACCESS_TOKEN=